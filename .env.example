# Sao chep thanh .env va doi gia tri. KHONG commit file .env.
# --- Database (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=tiecnha
DB_USER=tiecnha
DB_PASSWORD=change-me-db
# chi dung cho instance local / docker
DB_ROOT_PASSWORD=change-me-root

# --- Backend ---
# Khoa ky JWT: chuoi ngau nhien >= 32 ky tu
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Origin cua frontend duoc phep goi API (phan tach bang dau phay)
CORS_ORIGINS=http://localhost:5173
# dev = co seed tai khoan demo; prod = khong seed
SPRING_PROFILES_ACTIVE=dev

# --- Frontend ---
VITE_API_URL=http://localhost:8080
